APP_NAME=MIHIGO_9.8
ENVIRONMENT=development
LOG_LEVEL=INFO
PYTHONPATH=.

# Database
DATABASE_URL=sqlite:///./mihigo.db

# Email (example only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace_with_app_password
SMTP_SENDER=no-reply@example.com
SMTP_RECIPIENT=owner@example.com
SMTP_USE_TLS=true

# YouTube (example only)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=replace-me
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_PROJECT_ID=your-project-id

# AI providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare / D1 / R2 / Workers
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_AUTH_SECRET=

# Kaggle / Cloud Run
KAGGLE_USERNAME=
KAGGLE_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# Feature flags
USE_DRY_RUN=true
ENABLE_YOUTUBE_UPLOAD=false
ENABLE_EMAIL=true
ENABLE_SCHEDULER=false
